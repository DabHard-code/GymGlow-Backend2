{
  "expo": {
    "name": "GymGlow",
    "slug": "gymglow-native",
    "scheme": "gymglow",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "dark",
